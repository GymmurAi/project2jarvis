<svg width="1200" height="750" viewBox="0 0 1200 750" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="750" fill="#F5F3FF"/>

  <!-- Dashboard Window -->
  <rect x="100" y="50" width="1000" height="650" rx="16" fill="white" stroke="#E5E7EB" stroke-width="1"/>

  <!-- Header Bar -->
  <rect x="100" y="50" width="1000" height="60" rx="16" fill="#1E1B4B"/>
  <rect x="100" y="50" width="1000" height="30" rx="16" fill="#1E1B4B"/>
  <circle cx="130" cy="80" r="8" fill="#EF4444"/>
  <circle cx="155" cy="80" r="8" fill="#F59E0B"/>
  <circle cx="180" cy="80" r="8" fill="#10B981"/>
  <text x="220" y="85" font-family="Inter, sans-serif" font-size="16" font-weight="600" fill="white">Project2Jarvis Dashboard</text>

  <!-- Sidebar -->
  <rect x="100" y="110" width="200" height="590" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
  <text x="120" y="140" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#6B7280" letter-spacing="0.05em">AGENTS</text>

  <!-- Agent Items -->
  <rect x="110" y="155" width="180" height="50" rx="8" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <circle cx="135" cy="180" r="12" fill="#6366F1"/>
  <text x="155" y="184" font-family="Inter, sans-serif" font-size="14" font-weight="500" fill="#1E1B4B">Builder</text>
  <circle cx="275" cy="180" r="6" fill="#10B981"/>

  <rect x="110" y="215" width="180" height="50" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <circle cx="135" cy="240" r="12" fill="#818CF8"/>
  <text x="155" y="244" font-family="Inter, sans-serif" font-size="14" font-weight="500" fill="#1E1B4B">Researcher</text>

  <rect x="110" y="275" width="180" height="50" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <circle cx="135" cy="300" r="12" fill="#818CF8"/>
  <text x="155" y="304" font-family="Inter, sans-serif" font-size="14" font-weight="500" fill="#1E1B4B">Maintainer</text>

  <text x="120" y="360" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#6B7280" letter-spacing="0.05em">COUNCIL</text>

  <rect x="110" y="375" width="180" height="40" rx="6" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <text x="125" y="400" font-family="Inter, sans-serif" font-size="12" fill="#4B5563">Security Review</text>
  <circle cx="275" cy="395" r="8" fill="#F59E0B"/>

  <rect x="110" y="425" width="180" height="40" rx="6" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <text x="125" y="450" font-family="Inter, sans-serif" font-size="12" fill="#4B5563">Architecture Review</text>

  <!-- Main Content Area -->
  <rect x="310" y="110" width="790" height="590" fill="white"/>

  <!-- Stats Cards -->
  <rect x="330" y="130" width="180" height="100" rx="12" fill="#EEF2FF" stroke="#C7D2FE" stroke-width="1"/>
  <text x="350" y="155" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">ACTIVE TASKS</text>
  <text x="350" y="195" font-family="Inter, sans-serif" font-size="32" font-weight="700" fill="#6366F1">12</text>

  <rect x="530" y="130" width="180" height="100" rx="12" fill="#ECFDF5" stroke="#A7F3D0" stroke-width="1"/>
  <text x="550" y="155" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">COMPLETED</text>
  <text x="550" y="195" font-family="Inter, sans-serif" font-size="32" font-weight="700" fill="#10B981">248</text>

  <rect x="730" y="130" width="180" height="100" rx="12" fill="#FEF3C7" stroke="#FDE68A" stroke-width="1"/>
  <text x="750" y="155" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">SUCCESS RATE</text>
  <text x="750" y="195" font-family="Inter, sans-serif" font-size="32" font-weight="700" fill="#F59E0B">98%</text>

  <!-- Activity Chart Area -->
  <rect x="330" y="250" width="580" height="200" rx="12" fill="#FAFAFE" stroke="#E5E7EB" stroke-width="1"/>
  <text x="350" y="275" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1E1B4B">Agent Activity (Last 7 Days)</text>

  <!-- Chart Bars -->
  <rect x="360" y="300" width="50" height="130" rx="4" fill="#C7D2FE"/>
  <rect x="430" y="340" width="50" height="90" rx="4" fill="#818CF8"/>
  <rect x="500" y="280" width="50" height="150" rx="4" fill="#6366F1"/>
  <rect x="570" y="320" width="50" height="110" rx="4" fill="#818CF8"/>
  <rect x="640" y="290" width="50" height="140" rx="4" fill="#6366F1"/>
  <rect x="710" y="350" width="50" height="80" rx="4" fill="#C7D2FE"/>
  <rect x="780" y="310" width="50" height="120" rx="4" fill="#818CF8"/>

  <!-- Day Labels -->
  <text x="370" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Mon</text>
  <text x="440" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Tue</text>
  <text x="510" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Wed</text>
  <text x="580" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Thu</text>
  <text x="650" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Fri</text>
  <text x="720" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Sat</text>
  <text x="790" y="460" font-family="Inter, sans-serif" font-size="10" fill="#6B7280">Sun</text>

  <!-- Recent Tasks -->
  <text x="330" y="490" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1E1B4B">Recent Tasks</text>

  <rect x="330" y="505" width="580" height="55" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <circle cx="355" cy="532" r="10" fill="#10B981"/>
  <text x="375" y="528" font-family="Inter, sans-serif" font-size="13" font-weight="500" fill="#1E1B4B">Implement user authentication system</text>
  <text x="375" y="545" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">Builder • 2 min ago</text>
  <rect x="850" y="520" width="50" height="24" rx="12" fill="#ECFDF5"/>
  <text x="860" y="536" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#10B981">Done</text>

  <rect x="330" y="570" width="580" height="55" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <circle cx="355" cy="597" r="10" fill="#F59E0B"/>
  <text x="375" y="593" font-family="Inter, sans-serif" font-size="13" font-weight="500" fill="#1E1B4B">Security review for auth module</text>
  <text x="375" y="610" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">Council • 15 min ago</text>
  <rect x="850" y="585" width="50" height="24" rx="12" fill="#FEF3C7"/>
  <text x="860" y="601" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#F59E0B">Rev</text>

  <rect x="330" y="635" width="580" height="55" rx="8" fill="white" stroke="#E5E7EB" stroke-width="1"/>
  <circle cx="355" cy="662" r="10" fill="#6366F1"/>
  <text x="375" y="658" font-family="Inter, sans-serif" font-size="13" font-weight="500" fill="#1E1B4B">Update dependencies to latest versions</text>
  <text x="375" y="675" font-family="Inter, sans-serif" font-size="11" fill="#6B7280">Maintainer • 1 hr ago</text>
  <rect x="850" y="650" width="50" height="24" rx="12" fill="#EEF2FF"/>
  <text x="860" y="666" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#6366F1">Run</text>

  <!-- Memory Badge -->
  <rect x="940" y="130" width="140" height="100" rx="12" fill="#1E1B4B"/>
  <text x="960" y="155" font-family="Inter, sans-serif" font-size="11" fill="#A5B4FC">3-LAYER MEMORY</text>
  <text x="960" y="175" font-family="Inter, sans-serif" font-size="10" fill="#C7D2FE">✓ MEMORY.md</text>
  <text x="960" y="195" font-family="Inter, sans-serif" font-size="10" fill="#C7D2FE">✓ Auto-summary</text>
  <text x="960" y="215" font-family="Inter, sans-serif" font-size="10" fill="#C7D2FE">✓ Knowledge Base</text>
  <circle cx="1050" cy="240" r="20" fill="#6366F1"/>
  <text x="1043" y="247" font-family="Inter, sans-serif" font-size="18" font-weight="700" fill="white">M</text>
</svg>
